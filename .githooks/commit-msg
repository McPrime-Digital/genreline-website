#!/bin/sh
# Strip AI co-author trailers from every commit message (owner, 2026-10-03:
# "stop adding the coauthored by claude ... the whole repo"). Active in a
# clone once `git config core.hooksPath .githooks` has been run; CLAUDE.md
# records that step. Nothing else in the message is touched.
f="$1"
tmp="$f.tmp"
grep -v -E '^Co-Authored-By: Claude|^🤖 Generated with \[Claude Code\]' "$f" > "$tmp" && mv "$tmp" "$f"
exit 0
